__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
.DS_Store

.claude-costs*

# Secrets — `.env.example` is the template that's checked in.
.env

# config/effects/ IS tracked: one effect library, shared by every device through
# git. Only write-then-rename leftovers and local backups stay out.
config/**/*.tmp
config/effects_originals_*/

# Frames file moved temporarily during the v2 surface refactor.
/tmp/frames_v1.py
# Private connection details for the Pi (hostnames, IPs, password).
cmds.txt

# WZRD input: operator settings are runtime state; the scratch config is for
# developing next to a running WZRD / audio server (docs: wzrd-input).
config/wzrd_input.yaml
# What LIVE showed (layers + playlist running), restored on boot: runtime state.
config/live.yaml
config/config.wzrd-check.yaml
